# Copy to .env and fill in. .env is gitignored.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# Address the game client is told to connect to for the lobby.
# 127.0.0.1 for local-only; your LAN IPv4 for a phone/emulator on the network.
LOBBY_HOST=127.0.0.1

# Host interface the ports are published on. 0.0.0.0 to accept LAN connections.
BIND_IP=127.0.0.1

HOST_UID=1000
HOST_GID=1000

# Where the ~11-20 GB of game resources live (tools/fetch_resources.py --resources <dir>).
RESOURCES_DIR=./resources
